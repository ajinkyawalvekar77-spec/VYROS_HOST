# Leave empty to use the Vite /api proxy during development.
VITE_API_BASE_URL=

# Optional Vite development proxy destination for the FastAPI service.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Local development only: works only on loopback hosts and with the backend
# local-access flag enabled. Do not expose a backend started in this mode.
VITE_ENABLE_LOCAL_DEMO_ACCESS=true
